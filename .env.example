APP_NAME="Rekap Pendaftaran BU"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# === DATABASE (Railway PostgreSQL - set via Railway Variables) ===
DB_CONNECTION=pgsql
DB_URL=${DATABASE_URL}

# === SESSION & CACHE ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
